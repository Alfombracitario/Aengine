.SUFFIXES:

ifeq ($(strip $(DEVKITARM)),)
$(error "Please set DEVKITARM in your environment. export DEVKITARM=<path to>devkitARM")
endif

include $(DEVKITARM)/gba_rules

#---------------------------------------------------------------------------------
TARGET		:=	$(notdir $(CURDIR))
BUILD		:=	build
SOURCES		:=	source \
				source/engine \
				source/engine/gba \
				source/engine/general \
				source/scenes \
				source/objects \
				source/tiles \
				source/effects \
				source/scripts \
				source/platform/gba 

DATA		:=	assets assets/graphics
MUSIC		:=
INCLUDES	:=	source

#---------------------------------------------------------------------------------
ARCH	:=	-mthumb -mthumb-interwork

CFLAGS	:=	-g -Wall -O2 \
			-mcpu=arm7tdmi -mtune=arm7tdmi \
			$(ARCH)
CFLAGS	+=	$(INCLUDE)
CFLAGS	+=	-DCURRENT_PLATFORM=PLATFORM_GBA

ifeq ($(DEBUG),1)
	CFLAGS += -DDEBUG_MODE
endif

CXXFLAGS	:=	$(CFLAGS) -fno-rtti -fno-exceptions
ASFLAGS		:=	-g $(ARCH)
LDFLAGS		=	-g $(ARCH) -Wl,-Map,$(notdir $*.map)

#---------------------------------------------------------------------------------
LIBS	:= -lgba

ifneq ($(strip $(MUSIC)),)
	LIBS += -lmm
endif

LIBDIRS	:=	$(LIBGBA)

#---------------------------------------------------------------------------------
ifneq ($(BUILD),$(notdir $(CURDIR)))
#---------------------------------------------------------------------------------

export OUTPUT	:=	$(CURDIR)/dist/gba/$(TARGET)

export VPATH	:=	$(foreach dir,$(SOURCES),$(CURDIR)/$(dir)) \
					$(foreach dir,$(DATA),$(CURDIR)/$(dir))

export DEPSDIR	:=	$(CURDIR)/$(BUILD)

CFILES		:=	$(foreach dir,$(SOURCES),$(notdir $(wildcard $(dir)/*.c)))
CPPFILES	:=	$(foreach dir,$(SOURCES),$(notdir $(wildcard $(dir)/*.cpp)))
SFILES		:=	$(foreach dir,$(SOURCES),$(notdir $(wildcard $(dir)/*.s)))
BINFILES	:=	$(foreach dir,$(DATA),$(notdir $(wildcard $(dir)/*.*)))

ifneq ($(strip $(MUSIC)),)
	export AUDIOFILES	:=	$(foreach dir,$(notdir $(wildcard $(MUSIC)/*.*)),$(CURDIR)/$(MUSIC)/$(dir))
	BINFILES += soundbank.bin
endif

#---------------------------------------------------------------------------------
ifeq ($(strip $(CPPFILES)),)
	export LD	:=	$(CC)
else
	export LD	:=	$(CXX)
endif
#---------------------------------------------------------------------------------

export OFILES_BIN		:=	$(addsuffix .o,$(BINFILES))
export OFILES_SOURCES	:=	$(CPPFILES:.cpp=.o) $(CFILES:.c=.o) $(SFILES:.s=.o)
export OFILES			:=	$(OFILES_BIN) $(OFILES_SOURCES)
export HFILES			:=	$(addsuffix .h,$(subst .,_,$(BINFILES)))

export INCLUDE	:=	$(foreach dir,$(INCLUDES),-iquote $(CURDIR)/$(dir)) \
					$(foreach dir,$(LIBDIRS),-I$(dir)/include) \
					-I$(CURDIR)/$(BUILD)

export LIBPATHS	:=	$(foreach dir,$(LIBDIRS),-L$(dir)/lib)

.PHONY: $(BUILD) clean distclean run

$(BUILD):
	@[ -d $@ ] || mkdir -p $@
	@mkdir -p $(CURDIR)/dist/gba
	@$(MAKE) --no-print-directory -C $(BUILD) -f $(CURDIR)/Makefile.GBA PLATFORM=$(PLATFORM)

clean:
	@echo clean ...
	@rm -fr $(BUILD)

distclean:
	@echo distclean ...
	@rm -f $(CURDIR)/dist/gba/$(TARGET).elf
	@rm -f $(CURDIR)/dist/gba/$(TARGET).gba

run:
	mgba $(CURDIR)/dist/gba/$(TARGET).gba

#---------------------------------------------------------------------------------
else
#---------------------------------------------------------------------------------

DEPENDS	:=	$(OFILES:.o=.d)

$(OUTPUT).gba	:	$(OUTPUT).elf
$(OUTPUT).elf	:	$(OFILES)
$(OFILES_SOURCES) : $(HFILES)

#---------------------------------------------------------------------------------
# Soundbank (maxmod) — sólo si MUSIC está definido
#---------------------------------------------------------------------------------
ifneq ($(strip $(AUDIOFILES)),)
soundbank.bin soundbank.h : $(AUDIOFILES)
	@mmutil $^ -osoundbank.bin -hsoundbank.h
endif

#---------------------------------------------------------------------------------
# Reglas bin2o para assets
#---------------------------------------------------------------------------------
%.png.o	%_png.h :	%.png
	@echo $(notdir $<)
	@$(bin2o)

%.bmp.o	%_bmp.h :	%.bmp
	@echo $(notdir $<)
	@$(bin2o)

%.bin.o	%_bin.h :	%.bin
	@echo $(notdir $<)
	@$(bin2o)

%.room.o %_room.h : %.room
	@echo $(notdir $<)
	@$(bin2o)

%.acs.o %_acs.h : %.acs
	@echo $(notdir $<)
	@$(bin2o)
	
-include $(DEPENDS)

#---------------------------------------------------------------------------------
endif
#---------------------------------------------------------------------------------
