# ─── Aengine snes_rules ───────────────────────────────────────────────────────
# Basado en ${PVSNESLIB_HOME}/devkitsnes/snes_rules
# Modificaciones:
#   - SRCDIRS reemplaza SRC (soporta múltiples directorios)
#   - Objetos intermedios van a build/snes/ en vez de esparcirse por source/
#   - VPATH configurado automáticamente desde SRCDIRS

# ─── Validaciones ─────────────────────────────────────────────────────────────
ifeq ($(findstring \,$(PVSNESLIB_HOME)),\)
$(error "PVSNESLIB_HOME must use Unix-style paths (e.g. /c/pvsneslib, not c:\pvsneslib)")
endif

ifeq ($(PVSNESLIB_DEBUG),1)
DEBUG = 1
$(info The debug mode is enabled)
else
DEBUG = 0
$(info The debug mode is NOT enabled, you can do it by executing "export PVSNESLIB_DEBUG=1")
endif

# ─── ROM type ─────────────────────────────────────────────────────────────────
ifeq ($(HIROM),1)
HIROM = 1
$(info HiROM compilation is enabled)
ifeq ($(FASTROM),1)
LIBDIRSOBJS := $(PVSNESLIB_HOME)/pvsneslib/lib/HiROM_FastROM
else
LIBDIRSOBJS := $(PVSNESLIB_HOME)/pvsneslib/lib/HiROM_SlowROM
endif
else
HIROM = 0
$(info LoROM compilation is enabled)
ifeq ($(FASTROM),1)
LIBDIRSOBJS := $(PVSNESLIB_HOME)/pvsneslib/lib/LoROM_FastROM
else
LIBDIRSOBJS := $(PVSNESLIB_HOME)/pvsneslib/lib/LoROM_SlowROM
endif
endif

ifeq ($(FASTROM),1)
FASTROM = 1
$(info FastROM compilation is enabled)
else
FASTROM = 0
$(info SlowROM compilation is enabled)
endif

# ─── Windows linkfile path fix ────────────────────────────────────────────────
ifeq ($(OS),Windows_NT)
DRIDIROBJW   := $(wordlist 1,1,$(subst /, ,${LIBDIRSOBJS}))
REPDIROBJSW  := $(subst /,\\,${LIBDIRSOBJS})
REPDIROBJSW1 := $$(echo "$(REPDIROBJSW)" | sed 's/^.\{3\}//')
LIBDIRSOBJSW := ${DRIDIROBJW}:\\${REPDIROBJSW1}
else
LIBDIRSOBJSW := ${LIBDIRSOBJS}
endif

# ─── Herramientas ─────────────────────────────────────────────────────────────
export CC      := $(PVSNESLIB_HOME)/devkitsnes/bin/816-tcc
export AS      := $(PVSNESLIB_HOME)/devkitsnes/bin/wla-65816
export AS700   := $(PVSNESLIB_HOME)/devkitsnes/bin/wla-spc700
export LD      := $(PVSNESLIB_HOME)/devkitsnes/bin/wlalink
export GFXCONV := $(PVSNESLIB_HOME)/devkitsnes/tools/gfx4snes
export GFX2CONV:= $(PVSNESLIB_HOME)/devkitsnes/tools/gfx2snes
export SMCONV  := $(PVSNESLIB_HOME)/devkitsnes/tools/smconv
export BRCONV  := $(PVSNESLIB_HOME)/devkitsnes/tools/snesbrr
export TXCONV  := $(PVSNESLIB_HOME)/devkitsnes/tools/bin2txt
export SNTOOLS := $(PVSNESLIB_HOME)/devkitsnes/tools/snestools
export TMXCONV := $(PVSNESLIB_HOME)/devkitsnes/tools/tmx2snes
export OPT     := $(PVSNESLIB_HOME)/devkitsnes/tools/816-opt
export CTF     := $(PVSNESLIB_HOME)/devkitsnes/tools/constify

# ─── Flags base ───────────────────────────────────────────────────────────────
CFLAGS += -I$(PVSNESLIB_HOME)/pvsneslib/include \
          -I$(PVSNESLIB_HOME)/devkitsnes/include \
          -I$(CURDIR) \
          $(foreach dir,$(SRCDIRS),-I$(CURDIR)/$(dir))

# ─── Directorio de build ──────────────────────────────────────────────────────
BUILD_DIR := $(CURDIR)/build/snes

# ─── VPATH: make busca los .c en todos los SRCDIRS ───────────────────────────
empty :=
space := $(empty) $(empty)
VPATH := $(subst $(space),:,$(SRCDIRS))

# ─── Archivos fuente ──────────────────────────────────────────────────────────
# Audio
ifneq ($(strip $(AUDIOFILES)),)
    _AUDIO_ASM := $(SOUNDBANK).asm
else
    _AUDIO_ASM :=
endif

CFILES  := $(foreach dir,$(SRCDIRS),$(wildcard $(dir)/*.c))
ASMFILES:= $(foreach dir,$(SRCDIRS),$(wildcard $(dir)/*.asm))
ASMFILES:= $(_AUDIO_ASM) $(ASMFILES)

# ─── OFILES: paths completos en build/snes ────────────────────────────────────
# Cada .c → build/snes/<path relativo>.obj
# Cada .asm → build/snes/<path relativo>.obj
_COBJ   := $(patsubst %.c,  $(BUILD_DIR)/%.obj, $(CFILES))
_AOBJ   := $(patsubst %.asm,$(BUILD_DIR)/%.obj, $(ASMFILES))

export OFILES := $(BINFILES:.bin=$(BUILD_DIR)/%.obj) $(_COBJ) $(_AOBJ)

.DEFAULT_GOAL := all

# ─── Reglas de compilación ────────────────────────────────────────────────────
# .c → .obj (con pasos intermedios .ps / .asm en build/snes)
$(BUILD_DIR)/%.obj: %.c
	@mkdir -p $(dir $@)
	@echo Compiling ... $(notdir $<)
ifeq ($(HIROM),1)
ifeq ($(FASTROM),1)
	$(CC) $(CFLAGS) -Wall -c $< -H -F -o $(@:.obj=.ps)
else
	$(CC) $(CFLAGS) -Wall -c $< -H -o $(@:.obj=.ps)
endif
else
ifeq ($(FASTROM),1)
	$(CC) $(CFLAGS) -Wall -c $< -F -o $(@:.obj=.ps)
else
	$(CC) $(CFLAGS) -Wall -c $< -o $(@:.obj=.ps)
endif
endif
ifeq ($(DEBUG),1)
	cp $(@:.obj=.ps) $(@:.obj=.ps.01.dbg)
endif
	@echo Optimizing ... $(notdir $<)
	$(OPT) $(@:.obj=.ps) > $(@:.obj=.asp)
ifeq ($(DEBUG),1)
	cp $(@:.obj=.asp) $(@:.obj=.opt.02.dbg)
endif
	@echo Constifying ... $(notdir $<)
	$(CTF) $< $(@:.obj=.asp) $(@:.obj=.asm)
ifeq ($(DEBUG),1)
	cp $(@:.obj=.asp) $(@:.obj=.ctf.03.dbg)
endif
	@rm $(@:.obj=.asp) $(@:.obj=.ps)
	$(AS) -d -s -x -o $@ $(@:.obj=.asm)

# .asm → .obj directo
$(BUILD_DIR)/%.obj: %.asm
	@mkdir -p $(dir $@)
	@echo Assembling ... $(notdir $<)
	$(AS) -d -s -x -o $@ $<

# ─── Link ─────────────────────────────────────────────────────────────────────
%.sfc: $(OFILES)
	@echo Creating linkfile ...
	@echo [objects] > linkfile
	@for i in $(OFILES); do \
		echo $$i >> linkfile; \
	done
	@for i in $(shell ls $(LIBDIRSOBJSW)); do \
		echo $(LIBDIRSOBJSW)/$$i >> linkfile; \
	done
	@echo Linking ... $(notdir $@)
	@rm -f $(ROMNAME).sym
	$(LD) -d -s -v -A -c -L ${LIBDIRSOBJS} linkfile $@
	@sed -i 's/://' $(ROMNAME).sym
	@sed -i '/ SECTIONSTART_/d;/ SECTIONEND_/d;/ RAM_USAGE_SLOT_/d;' $(ROMNAME).sym
	@echo
	@echo Build finished successfully !
	@echo

# ─── Conversiones de assets ───────────────────────────────────────────────────
%.pic: %.bmp
	@echo convert bitmap ... $(notdir $<)
	$(GFXCONV) -s 8 -o 16 -u 16 -e 0 -p -m -t bmp -i $<

%.brr: %.wav
	@echo convert wav file ... $(notdir $<)
	$(BRCONV) -e $< $@

$(SOUNDBANK).asm: $(AUDIOFILES)
	@echo Compiling Soundbank ...
	$(SMCONV) $(SMCONVFLAGS) $^

# ─── Clean targets ────────────────────────────────────────────────────────────
.PHONY: cleanBuildRes cleanRom cleanGfx cleanAudio cleanDebug

cleanBuildRes: cleanDebug
	@echo clean build resources
	@rm -rf $(BUILD_DIR)
	@rm -f linkfile

cleanRom:
	@echo clean rom
	@rm -f $(ROMNAME).sfc $(ROMNAME).sym

cleanGfx:
	@echo clean graphics data
	@rm -f *.pic *.map *.pal *.pc7 *.mp7 *.til *.m16 *.b16 *.o16 *.t16 *.as *.inc

cleanAudio:
	@echo clean audio data
	@rm -f $(SOUNDBANK).asm $(SOUNDBANK).h $(SOUNDBANK).bnk

cleanDebug:
ifeq ($(DEBUG),1)
	@echo clean debug files
	@find $(BUILD_DIR) -type f -name "*.dbg" -delete 2>/dev/null; true
endif
